  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
    html { font-size: 16px; scroll-behavior: smooth; }
    :root {
      --bg: #f5f3ee;
      --surface: #eceae4;
      --text-primary: #1a1f1a;
      --text-secondary: #4a5240;
      --text-tertiary: #8a9180;
      --green-muted: #4a7c59;
      --green-bright: #6aad80;
      --green-dim: #d4e4da;
      --border: rgba(74,124,89,0.15);
      --ease: cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }
    body { background: var(--bg); color: var(--text-primary); font-family: 'DM Sans', sans-serif; font-weight: 300; -webkit-font-smoothing: antialiased; }

    /* TOPBAR */
    .topbar { position: fixed; top: 0; left: 0; right: 0; z-index: 100; height: 56px; background: rgba(245,243,238,0.92); backdrop-filter: blur(12px); border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; padding: 0 40px; }
    .topbar-back { font-size: 12px; letter-spacing: 0.1em; color: var(--text-secondary); text-decoration: none; display: flex; align-items: center; gap: 8px; transition: color 0.2s ease; }
    .topbar-back:hover { color: var(--green-muted); }
    .topbar-back::before { content: '←'; font-size: 14px; }
    .topbar-section { font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--text-tertiary); }

    /* LAYOUT */
    .page-layout { display: grid; grid-template-columns: 240px 1fr; min-height: 100vh; padding-top: 56px; }

    /* SIDEBAR */
    .sidebar { position: sticky; top: 56px; height: calc(100vh - 56px); overflow-y: auto; border-right: 1px solid var(--border); padding: 48px 32px; display: flex; flex-direction: column; gap: 40px; }
    .sidebar-group-label { font-size: 10px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--text-tertiary); margin-bottom: 14px; }
    .sidebar-links { list-style: none; display: flex; flex-direction: column; gap: 10px; }
    .sidebar-links a { font-size: 13px; font-weight: 300; color: var(--text-secondary); text-decoration: none; padding-left: 12px; border-left: 2px solid transparent; transition: color 0.2s ease, border-color 0.2s ease; display: block; }
    .sidebar-links a:hover, .sidebar-links a.active { color: var(--green-muted); border-left-color: var(--green-muted); }
    .sidebar-contact { margin-top: auto; }
    .sidebar-contact a { font-size: 12px; color: var(--green-muted); text-decoration: none; transition: opacity 0.2s ease; }
    .sidebar-contact a:hover { opacity: 0.7; }

    /* MAIN */
    .main-content { padding: 64px 80px 120px; max-width: 860px; }

    /* HEADER */
    .page-header { margin-bottom: 56px; opacity: 0; animation: fadeUp 0.7s var(--ease) 0.1s forwards; }
    .page-header-label { font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--green-muted); margin-bottom: 16px; }
    .page-header h1 { font-family: 'Cormorant Garamond', serif; font-size: clamp(40px, 5vw, 64px); font-weight: 300; line-height: 1.0; letter-spacing: -0.02em; }
    .page-header h1 em { font-style: italic; color: var(--green-muted); }
    .page-intro { font-size: 15px; color: var(--text-secondary); line-height: 1.7; margin-top: 20px; max-width: 540px; }

    /* ARTICLE CARDS — vertical bars */
    .articles-list { display: flex; flex-direction: column; gap: 0; }

    .article-card {
      border-top: 1px solid var(--border);
      padding: 32px 0;
      display: grid;
      grid-template-columns: 80px 1fr auto;
      gap: 32px;
      align-items: start;
      text-decoration: none;
      color: inherit;
      opacity: 0;
      transform: translateY(16px);
      transition: background 0.25s ease;
      cursor: pointer;
    }
    .article-card:last-child { border-bottom: 1px solid var(--border); }
    .article-card.visible { opacity: 1; transform: translateY(0); transition: opacity 0.6s var(--ease), transform 0.6s var(--ease), background 0.25s ease; }
    .article-card:hover { background: var(--surface); margin: 0 -24px; padding-left: 24px; padding-right: 24px; border-radius: 8px; border-top-color: transparent; }
    .article-card:hover + .article-card { border-top-color: transparent; }

    .article-number { font-size: 11px; letter-spacing: 0.1em; color: var(--text-tertiary); padding-top: 6px; font-variant-numeric: tabular-nums; }

    .article-body {}
    .article-tag {
      display: inline-block;
      font-size: 10px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--green-muted);
      background: var(--green-dim);
      padding: 3px 10px;
      border-radius: 20px;
      margin-bottom: 12px;
    }
    .article-title { font-family: 'Cormorant Garamond', serif; font-size: clamp(20px, 2.2vw, 27px); font-weight: 400; line-height: 1.2; color: var(--text-primary); margin-bottom: 12px; letter-spacing: -0.01em; }
    .article-excerpt { font-size: 13px; line-height: 1.7; color: var(--text-secondary); max-width: 500px; opacity: 0.7; transition: opacity 0.25s ease; }
    .article-card:hover .article-excerpt { opacity: 1; }
    .article-meta { font-size: 11px; color: var(--text-tertiary); margin-top: 14px; letter-spacing: 0.04em; }

    .article-arrow { font-size: 18px; color: var(--text-tertiary); padding-top: 6px; transition: color 0.25s ease, transform 0.25s ease; }
    .article-card:hover .article-arrow { color: var(--green-muted); transform: translate(3px, -3px); }

    /* ARTICLE READER — opens below card on click */
    .article-reader {
      display: none;
      background: var(--surface);
      border-radius: 12px;
      padding: 48px 56px;
      margin: 8px 0 32px;
      border: 1px solid var(--border);
      animation: fadeUp 0.4s var(--ease) forwards;
    }
    .article-reader.open { display: block; }
    .reader-close { float: right; font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-tertiary); cursor: pointer; border: 1px solid var(--border); padding: 6px 14px; border-radius: 20px; background: none; transition: color 0.2s ease, border-color 0.2s ease; }
    .reader-close:hover { color: var(--green-muted); border-color: var(--green-muted); }
    .reader-title { font-family: 'Cormorant Garamond', serif; font-size: clamp(26px, 3vw, 36px); font-weight: 400; line-height: 1.15; margin: 24px 0 8px; letter-spacing: -0.01em; }
    .reader-byline { font-size: 12px; color: var(--text-tertiary); letter-spacing: 0.06em; margin-bottom: 32px; padding-bottom: 24px; border-bottom: 1px solid var(--border); }
    .reader-body { font-size: 16px; line-height: 1.95; color: var(--text-secondary); }
    .reader-body p + p { margin-top: 20px; }
    .reader-body strong { color: var(--text-primary); font-weight: 500; }

    @keyframes fadeUp { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: translateY(0); } }

    @media (max-width: 900px) {
      .page-layout { grid-template-columns: 1fr; }
      .sidebar { position: static; height: auto; border-right: none; border-bottom: 1px solid var(--border); padding: 24px; flex-direction: row; flex-wrap: wrap; gap: 16px; }
      .sidebar-contact { margin-top: 0; }
      .main-content { padding: 40px 24px 80px; }
      .article-card { grid-template-columns: 48px 1fr auto; gap: 16px; }
      .article-reader { padding: 32px 24px; }
    }
